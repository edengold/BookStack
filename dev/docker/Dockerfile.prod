# Production image: deps baked, assets built, no volume mounts required.
# Multi-stage so the node toolchain never ships in the final image.

# ---- Stage 1: PHP deps (production only, no autoloader-dev) ----
FROM composer:2 AS composer-deps
RUN apk add --no-cache \
        freetype-dev libjpeg-turbo-dev libpng-dev zlib-dev && \
    docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) gd
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --no-progress
COPY app/ ./app/
COPY database/ ./database/
COPY lang/ ./lang/
COPY resources/ ./resources/
COPY routes/ ./routes/
COPY themes/ ./themes/
COPY bootstrap/ ./bootstrap/
COPY artisan ./artisan
RUN mkdir -p bootstrap/cache storage/framework/views \
        storage/framework/cache \
        storage/framework/sessions \
        storage/fonts && \
    composer dump-autoload --optimize --no-interaction

# ---- Stage 2: JS/CSS production assets ----
FROM node:22 AS node-assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY resources/ ./resources/
COPY dev/build/ ./dev/build/
COPY .browserslistrc* ./
RUN npm run production

# ---- Stage 3: Final image ----
FROM php:8.3-apache

RUN apt-get update && \
    apt-get install -y \
        libfreetype-dev \
        libjpeg62-turbo-dev \
        libldap2-dev \
        libpng-dev \
        libzip-dev \
        wait-for-it && \
    rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure ldap --with-libdir="lib/$(gcc -dumpmachine)" && \
    docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) pdo_mysql gd ldap zip

# Configure apache
RUN a2enmod rewrite && \
    sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf && \
    sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Use the default production configuration and update it as required
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/memory_limit = 128M/memory_limit = 512M/g' "$PHP_INI_DIR/php.ini"

ENV APACHE_DOCUMENT_ROOT="/app/public"

WORKDIR /app

# Application source
COPY . .
COPY --from=composer-deps /app/vendor /app/vendor
COPY --from=composer-deps /app/storage /app/storage
COPY --from=node-assets /build/public/dist /app/public/dist

# Regenerate package discovery so it matches the --no-dev vendor tree,
# not the local bootstrap/cache/packages.php committed in by COPY . .
RUN mkdir -p bootstrap/cache && \
    php artisan package:discover --ansi

RUN chown -R www-data:www-data storage bootstrap/cache public/uploads

COPY --chmod=755 <<'EOF' /usr/local/bin/entrypoint
#!/bin/bash
set -e

if [[ -n "$1" ]]; then
    exec "$@"
fi

wait-for-it db:3306 -t 45
php artisan migrate --database=mysql --force
exec apache2-foreground
EOF
ENTRYPOINT ["/usr/local/bin/entrypoint"]
